{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2021"],
    "module": "ESNext",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@storybook-utils/*": ["./.storybook/*"],
      "@test/*": ["./test/*"],
      "react-color-x": ["./src/index.ts"],
      "react-color-x/es/*": ["./es/*"]
    },
    "target": "ES2021",
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": [
    "*.ts",
    "*.d.ts",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "scripts/**/*.js",
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "scripts/**/*.d.ts",
    ".storybook/**/*.js",
    ".storybook/**/*.mjs",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "site/**/*.ts",
    "site/**/*.tsx",
    "site/**/*.d.ts",
    "test/**/*.js",
    "test/**/*.jsx",
    "test/**/*.mjs",
    "test/**/*.ts",
    "test/**/*.tsx",
    "test/**/*.d.ts"
  ],
  "exclude": ["node_modules", "site/dist", "lib", "es", "test/public-types"]
}
