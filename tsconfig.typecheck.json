{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "checkJs": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "paths": {
      "react-color": ["./index.d.ts"],
      "react-color/es/*": ["./es/*"],
      "react-color/lib/*": ["./lib/*"]
    },
    "skipLibCheck": true,
    "strictNullChecks": true,
    "target": "ES2020",
    "types": ["vite/client"],
    "useDefineForClassFields": false
  },
  "include": [
    "*.ts",
    "*.d.ts",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "docs/**/*.js",
    "docs/**/*.jsx",
    "docs/**/*.ts",
    "docs/**/*.tsx",
    "docs/**/*.d.ts",
    "scripts/**/*.js",
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "scripts/**/*.d.ts",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "examples/**/*.d.ts",
    "test/**/*.js",
    "test/**/*.jsx",
    "test/**/*.mjs",
    "test/**/*.ts",
    "test/**/*.tsx",
    "test/**/*.d.ts"
  ],
  "exclude": ["node_modules", "docs/build", "lib", "es", "src/**/spec.*", "src/**/story.*"]
}
