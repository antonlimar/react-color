{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "checkJs": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2021"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "paths": {
      "@/*": ["./src/*"],
      "@storybook-utils/*": ["./.storybook/*"],
      "@test/*": ["./test/*"],
      "react-color": ["./index.d.ts"],
      "react-color/es/*": ["./es/*"]
    },
    "skipLibCheck": true,
    "strictNullChecks": true,
    "target": "ES2021",
    "types": ["vite/client"],
    "useDefineForClassFields": false
  },
  "include": [
    "*.ts",
    "*.d.ts",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "scripts/**/*.js",
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "scripts/**/*.d.ts",
    "site/**/*.ts",
    "site/**/*.tsx",
    "site/**/*.d.ts",
    "test/**/*.js",
    "test/**/*.jsx",
    "test/**/*.mjs",
    "test/**/*.ts",
    "test/**/*.tsx",
    "test/**/*.d.ts"
  ],
  "exclude": ["node_modules", "site/dist", "lib", "es", "src/**/spec.*", "src/**/story.*"]
}
