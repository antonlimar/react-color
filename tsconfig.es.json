{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "module": "ESNext",
    "noEmit": false,
    "rootDir": "./src",
    "sourceMap": false,
    "outDir": "./es"
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": ["node_modules", "lib", "es", "src/**/spec.*", "src/**/story.*"]
}
