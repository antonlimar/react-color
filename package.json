{
  "name": "@antonlimar/react-color",
  "version": "3.0.9",
  "description": "A Collection of Color Pickers from Sketch, Photoshop, Chrome & more",
  "keywords": [
    "react",
    "color picker",
    "react-component",
    "picker",
    "sketch",
    "chrome",
    "photoshop",
    "material design",
    "popup"
  ],
  "author": {
    "name": "Anton Limar",
    "email": "antonreal93@gmail.com"
  },
  "homepage": "https://antonlimar.github.io/react-color/",
  "repository": "github:antonlimar/react-color",
  "license": "MIT",
  "bugs": "https://github.com/antonlimar/react-color/issues",
  "type": "module",
  "main": "es/index.js",
  "module": "es/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./es/index.js",
      "default": "./es/index.js"
    },
    "./es/components/common": {
      "types": "./es/components/common/index.d.ts",
      "import": "./es/components/common/index.js",
      "default": "./es/components/common/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean-es && tsc -p tsconfig.es.json && node scripts/build-styles.mjs es && node scripts/attach-picker-style-imports.mjs es && node scripts/rewrite-esm-import-specifiers.mjs es",
    "ci:artifacts": "node ./scripts/verify-generated-artifacts.mjs",
    "prepare": "husky",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test:public-types": "npm run build && tsc -p tsconfig.public-types.json",
    "test:esm-consumption": "npm run build && node ./scripts/esm-consumption-check.mjs",
    "test:unit": "vitest run -c vitest.config.ts",
    "test:site": "vitest run -c vitest.config.ts site/src/App.spec.tsx",
    "test:visual": "vitest run -c vitest.visual.config.ts && node ./scripts/site-visual-tests.mjs",
    "test:visual:update": "vitest run -c vitest.visual.config.ts --update && node ./scripts/site-visual-tests.mjs --update",
    "test:watch": "vitest -c vitest.config.ts",
    "lint": "npm run eslint && npm run stylelint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eslint": "eslint src site scripts test .storybook vite.site.config.ts vitest.config.ts vitest.visual.config.ts eslint.config.mjs",
    "stylelint": "stylelint \"src/**/*.scss\" \"site/src/**/*.scss\"",
    "stylelint:fix": "stylelint \"src/**/*.scss\" \"site/src/**/*.scss\" --fix",
    "clean-es": "rm -rf es && mkdir es",
    "prepack": "npm run build",
    "site:dev": "vite --config vite.site.config.ts --open",
    "site:build": "vite build --config vite.site.config.ts",
    "site:llms": "node ./scripts/generate-llms-docs.mjs",
    "site:preview": "SITE_BASE_PATH=/ npm run site:build && vite preview --config vite.site.config.ts --open",
    "site:content": "node ./scripts/validate-site-content.mjs",
    "site:verify": "npm run test:site && npm run site:content && npm run site:build && node ./scripts/verify-site-build.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o .out"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write --log-level silent"
    ],
    "*.{json,md,mdx,html,css,scss,yml,yaml}": "prettier --write --log-level silent",
    "*.scss": [
      "stylelint",
      "prettier --write --log-level silent"
    ]
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "bem-cn": "^3.0.1",
    "lodash-es": "^4.18.1",
    "material-colors": "^1.2.6",
    "tinycolor2": "^1.6.0"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tanstack/react-router": "^1.170.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/material-colors": "^1.2.3",
    "@types/node": "^24.13.6",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tinycolor2": "^1.4.6",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.105.0",
    "storybook": "^10.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "files": [
    "es",
    "index.d.ts"
  ],
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.27.7": true,
    "unrs-resolver@1.12.2": true
  }
}
