{
  "name": "react-color",
  "version": "2.19.3",
  "description": "A Collection of Color Pickers from Sketch, Photoshop, Chrome & more",
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/casesandberg/react-color.git"
  },
  "author": "case <case@casesandberg.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/casesandberg/react-color/issues"
  },
  "scripts": {
    "build": "npm run lib && npm run es",
    "test": "npm run test:unit && npm run eslint",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "examples:check": "node ./scripts/examples-check.mjs",
    "eslint": "eslint src",
    "lib": "npm run clean-lib && tsc -p tsconfig.lib.json",
    "es": "npm run clean-es && tsc -p tsconfig.es.json && node scripts/rewrite-lodash-es-imports.js es",
    "clean-lib": "rm -rf lib && mkdir lib",
    "clean-es": "rm -rf es && mkdir es",
    "prepack": "npm run build",
    "docs": "npm run docs-server",
    "docs-server": "node ./scripts/docs-server",
    "docs-dist": "node ./scripts/docs-dist",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o .out",
    "chromatic": "chromatic --project-token=9z2kaxsuz"
  },
  "sideEffects": false,
  "homepage": "http://casesandberg.github.io/react-color/",
  "keywords": [
    "react",
    "color picker",
    "react-component",
    "colorpicker",
    "picker",
    "sketch",
    "chrome",
    "photoshop",
    "material design",
    "popup"
  ],
  "dependencies": {
    "@icons/material": "^0.2.4",
    "lodash": "^4.17.15",
    "lodash-es": "^4.17.15",
    "material-colors": "^1.2.1",
    "prop-types": "^15.5.10",
    "reactcss": "^1.2.0",
    "tinycolor2": "^1.4.1"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@storybook/addon-docs": "^10.3.1",
    "@storybook/react-vite": "^10.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "highlight.js": "^9.3.0",
    "jsdom": "^29.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remarkable": "^1.6.0",
    "storybook": "^10.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  },
  "files": [
    "lib",
    "es",
    "index.d.ts"
  ],
  "payload": {
    "builds": [
      {
        "cmd": "npm run docs-dist",
        "files": [
          "docs/build/bundle.js",
          "docs/index.js"
        ]
      }
    ]
  }
}
