{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "lib": ["DOM", "DOM.Iterable", "ES2021"],
    "module": "ESNext",
    "noEmit": true,
    "sourceMap": false,
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": [
    "*.ts",
    "*.d.ts",
    ".storybook/**/*.js",
    ".storybook/**/*.mjs",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "test/**/*.js",
    "test/**/*.jsx",
    "test/**/*.mjs",
    "test/**/*.ts",
    "test/**/*.tsx",
    "test/**/*.d.ts"
  ],
  "exclude": ["node_modules", "lib", "es", "site/dist", "test/public-types"]
}
