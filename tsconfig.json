{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "checkJs": false,
    "declaration": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noEmit": false,
    "rootDir": "./src",
    "skipLibCheck": true,
    "sourceMap": false,
    "target": "ES2015",
    "useDefineForClassFields": false
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": ["node_modules", "lib", "es", "src/**/spec.*", "src/**/story.*"]
}
